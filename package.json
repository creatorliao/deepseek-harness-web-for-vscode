{
  "name": "deepseek-harness-for-vscode",
  "displayName": "DeepSeek Harness for VS Code",
  "description": "Launch DeepSeek Harness and embed its Web UI inside VS Code & Antigravity — one-click start, editor-tab panel, shared instance with the browser, clipboard and theme sync.",
  "version": "0.6.0",
  "publisher": "creatorliao",
  "author": {
    "name": "liaohai1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/creatorliao/deepseek-harness-for-vscode.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "media/**",
    "README.md",
    "README.en.md",
    "LICENSE",
    "package.nls.json",
    "media/icon.png",
    "node_modules/ws/**",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deepseek-harness-for-vscode.start",
        "title": "%command.start.title%",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseek-harness-for-vscode.stop",
        "title": "%command.stop.title%",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseek-harness-for-vscode.openBrowser",
        "title": "%command.openBrowser.title%",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseek-harness-for-vscode.openChatView",
        "title": "%command.openChatView.title%",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseek-harness-for-vscode.openPanel",
        "title": "%command.openPanel.title%",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseek-harness-for-vscode.addToContext",
        "title": "%command.addToContext.title%",
        "category": "DeepSeek Harness",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "deepseek-harness-for-vscode.addToContext",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "deepseek-harness-for-vscode.addToContext",
          "group": "navigation@10",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title": [
        {
          "command": "deepseek-harness-for-vscode.addToContext",
          "group": "navigation@10",
          "when": "resourceScheme == file"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deepseek-harness-for-vscode.addToContext",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness for VS Code",
      "properties": {
        "deepseekHarness.themeSync": {
          "type": "string",
          "enum": [
            "follow",
            "off"
          ],
          "default": "follow",
          "description": "%setting.themeSync.description%"
        },
        "deepseekHarness.dshPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.dshPath.description%"
        },
        "deepseekHarness.openTarget": {
          "type": "string",
          "enum": [
            "sidebar",
            "editorTab"
          ],
          "default": "sidebar",
          "markdownDescription": "%setting.openTarget.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-harness",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "deepseek-harness-chat",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "deepseek-harness": [
        {
          "type": "webview",
          "id": "deepseek-harness.view",
          "name": "DeepSeek Harness"
        }
      ],
      "deepseek-harness-chat": [
        {
          "type": "webview",
          "id": "deepseek-harness.chatView",
          "name": "DeepSeek Harness"
        }
      ],
      "explorer": [
        {
          "id": "deepseek-harness.contextDrop",
          "name": "%view.contextDrop.name%",
          "icon": "$(add)",
          "contextualTitle": "%view.contextDrop.name%"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node scripts/package.js",
    "install:local": "node scripts/install-local.js",
    "test": "tsc -p ./ && node --test",
    "check:dsh": "node scripts/check-dsh-latest.js",
    "check:docs": "node scripts/check-docs.js",
    "probe:composer": "node scripts/probe-composer-insert.js",
    "diagnose:dsh": "node scripts/diagnose-dsh.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "1.105.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "ai-agent",
    "coding-agent",
    "vscode",
    "webview",
    "antigravity",
    "ide",
    "harness"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
